APP_NAME="Inventario Total Ground"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://192.168.15.26/inventario
ASSET_URL=http://192.168.15.26/inventario
APP_TIMEZONE=America/Mexico_City

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Limita el numero de filas que puede generar una exportacion para proteger memoria.
INVENTORY_EXPORT_MAX_ROWS=10000
INVENTORY_MYSQLDUMP_PATH=C:\xampp\mysql\bin\mysqldump.exe
INVENTORY_BACKUP_RETENTION_DAYS=365
INVENTORY_BACKUP_MAX_LOCAL_FILES=50

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=inventario_laravel
DB_USERNAME=root
DB_PASSWORD=

# Base anterior usada solamente por inventory:readiness.
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=inventario
LEGACY_DB_USERNAME=root
LEGACY_DB_PASSWORD=
LEGACY_FILES_ROOT="C:\\xampp\\htdocs\\inventario"

SESSION_DRIVER=file
# When Redis is installed and running, use SESSION_DRIVER=redis and
# SESSION_STORE=redis for shared sessions between LAN clients.
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# When Redis is installed and running, use CACHE_STORE=redis.
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Observability
TELESCOPE_ENABLED=false
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_SEND_DEFAULT_PII=false

# Image optimization (run: php artisan inventory:optimize-images)
INVENTORY_IMAGE_SOURCE=public/images
INVENTORY_IMAGE_QUALITY=82

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
